# Supabase 프로젝트 > Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# service_role 키는 절대 브라우저에 노출 금지. 서버 라우트에서만 사용.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 로컬 개발 주소 (배포 시 https://viberhood.io)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (선택) 폴더 게임(/g/…)을 내려줄 게임 전용 주소 — 같은 배포에 붙인 두 번째 도메인.
# 정하면 게임이 자기 오리진을 가져 localStorage · IndexedDB · Web Worker 가 동작합니다.
# 운영 값은 저장소의 .env.production 에 둡니다. 로컬은 비워두면 127.0.0.1 을 자동으로 씁니다.
# NEXT_PUBLIC_GAME_ORIGIN=https://play.viberhood.io

# (선택) Vercel Blob — 대시보드에서 저장소를 프로젝트에 연결하면 Vercel 에 자동으로 생깁니다.
# 값이 있으면 운영자 콘솔의 게임 폴더 업로드가 Supabase 대신 Blob 으로 갑니다.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# 점수 제출 토큰 서명용 시크릿 (아무 긴 랜덤 문자열)
RUN_TOKEN_SECRET=change-me-to-a-long-random-string
